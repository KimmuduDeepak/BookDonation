<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Medicine Donation Web Application</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', sans-serif;
      background: url('/background1.jpg') no-repeat center center fixed;
      background-size: cover; 
      background-color: #000;
      color: #580707;
    }
  
    h1, h2 {
      text-align: center;
      margin-top: 30px;
      margin-bottom: 20px;
      color: #810e0e;
      text-shadow: 1px 1px 10px rgba(0,0,0,0.7);
    }
  
    a {
      color: #20c997;
      text-decoration: none;
      font-weight: bold;
    }
  
    a:hover {
      text-decoration: underline;
    }
  
    .wrapper, .receipt-box {
      backdrop-filter: blur(10px);
      background-color: rgba(255, 255, 255, 0.08);
      padding: 30px;
      border-radius: 16px;
      max-width: 400px;
      margin: 40px auto;
      box-shadow: 0 0 20px rgba(32, 201, 151, 0.2);
      color: #a85d5d;
      font-size: 18px;
      text-align: left;
    }
  
    .wrapper h2, .receipt-box h2 {
      text-align: center;
      color: #20c997;
    }
  
    ul {
      list-style: none;
      padding: 0;
      margin: 0 auto;
      max-width: 800px;
    }
  
    li {
      background-color: rgba(255, 255, 255, 0.05);
      padding: 20px;
      margin-bottom: 15px;
      border-radius: 12px;
      box-shadow: 0 0 10px rgba(32, 201, 151, 0.2);
      transition: 0.3s;
      text-align: center;
    }
  
    li:hover {
      box-shadow: 0 0 20px rgba(32, 201, 151, 0.4);
      transform: translateY(-5px);
    }
  
    li strong {
      display: block;
      font-size: 18px;
      color: #20c997;
      margin-bottom: 6px;
    }
  
    input, select, button {
      width: 100%;
      padding: 10px;
      margin: 10px 0;
      font-size: 16px;
      border: none;
      border-radius: 10px;
      background-color: rgba(255,255,255,0.1);
      color: #a16c6c;
      backdrop-filter: blur(5px);
    }
  
    input::placeholder, select {
      color: #791313;
    }
  
    button {
      background-color: #20c997;
      color: rgb(168, 118, 118);
      font-weight: bold;
      cursor: pointer;
      transition: 0.3s ease;
    }
  
    button:hover {
      background-color: #17a589;
    }
  
    .thank-you {
      font-size: 22px;
      color: #20c997;
      margin-top: 20px;
      text-align: center;
    }
  </style>
  
</head>
<body>
