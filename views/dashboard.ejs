<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Your Donations</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      margin: 0;
      padding: 0;
      min-height: 100vh;
      font-family: 'Segoe UI', sans-serif;
      background: url('/background1.jpg') no-repeat center center fixed;
      background-size: cover;
      color: #b42929;
    }

    h2 {
      text-align: center;
      margin: 30px 0;
      text-shadow: 1px 1px 10px rgba(0,0,0,0.7);
    }

    ul {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      padding: 20px 40px;
      list-style: none;
      margin: 0 auto;
      max-width: 1200px;
    }

    li {
      backdrop-filter: blur(10px);
      background-color: rgba(255, 255, 255, 0.08);
      padding: 20px;
      border-radius: 16px;
      box-shadow: 0 0 15px rgba(32, 201, 151, 0.15);
      text-align: center;
    }

    li:hover {
      box-shadow: 0 0 25px rgba(32, 201, 151, 0.35);
    }

    strong {
      color: #20c997;
      font-size: 18px;
    }

    .logout-btn {
      position: absolute;
      top: 20px;
      right: 30px;
      background: #20c997;
      color: rgb(136, 16, 16);
      padding: 10px 15px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: bold;
    }

    .logout-btn:hover {
      background: #17a589;
    }
  </style>
</head>
<body>
  <a href="/logout" class="logout-btn">Logout</a>
  <h2>Your Past Donations</h2>
  <ul>
    <% donations.forEach(donation => { %>
      <li>
        <p><strong>Book Name:</strong> <%= donation.bookName %></p>
        <p><strong>Quantity:</strong> <%= donation.quantity %></p>
        <p><strong>Expiry Date:</strong> <%= new Date(donation.expiryDate).toLocaleDateString() %></p>
        <p><strong>Donated On:</strong> <%= new Date(donation.donationDate).toLocaleDateString() %></p>
      </li>
    <% }) %>
  </ul>
</body>
</html>
